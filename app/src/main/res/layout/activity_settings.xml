<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кодовое слово"
            android:textColor="#8ecaff"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/wakePhraseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="катя слушай"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Город для погоды"
            android:textColor="#8ecaff"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/cityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ташкент"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сервер распознавания команд (Gemini)"
            android:textColor="#8ecaff"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://umnay-kolonka.onrender.com"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Музыка/видео — необязательно"
            android:textColor="#8ecaff"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/youtubeKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="YouTube Data API ключ"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/jamendoIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jamendo Client ID"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/spotifyIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Spotify Client ID"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/spotifySecretInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Spotify Client Secret"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/notificationAccessButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Разрешить управление медиа (для команды 'стоп')" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Умный дом (MQTT) — необязательно"
            android:textColor="#8ecaff"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/brokerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tcp://192.168.1.10:1883"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/topicInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="home/smart-speaker"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/userInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT логин (если есть)"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/passInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT пароль (если есть)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить" />

    </LinearLayout>
</ScrollView>
